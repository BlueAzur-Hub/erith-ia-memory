+def okx_fee_type_payload() -> dict[str, Any]:
+    """Read only the account Spot fee-currency selector; never echo config."""
+    config = okx_private_get("/api/v5/account/config")
+    rows = config.get("data")
+    if not isinstance(rows, list) or len(rows) != 1 or not isinstance(rows[0], dict):
+        raise ValueError("Configuration OKX non vérifiable.")
+    value = rows[0].get("feeType")
+    if value not in ("0", "1"):
+        raise ValueError("Devise des frais non certifiée.")
+    return {
+        "ok": True, "bridge_version": "1.9.17", "read_only": True,
+        "source": "OKX Private REST /api/v5/account/config",
+        "fetched_at": datetime.now(timezone.utc).isoformat(),
+        "fee_type": value,
+        "fee_currency_for_spot_buy_ct_usdc": "CT" if value == "0" else "USDC",
+        "scope": "spot_fee_currency_mode_for_account",
+        "orders_enabled": False, "fee_amount_and_rounding_verified": False,
     }
 
 
