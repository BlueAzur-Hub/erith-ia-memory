@@
 OKX_INSTRUMENTS = {asset: f"{asset}-EUR" for asset in DEFAULT_ASSETS}
+OKX_PUBLIC_QUOTES = ("EUR", "USDC", "USDT")
@@
+def _normalize_okx_public_asset(value: Any) -> str:
+    asset = str(value or "").strip().upper()
+    if not (2 <= len(asset) <= 16 and asset.isalnum()):
+        raise ValueError("unsupported OKX asset")
+    return asset
+
+def _normalize_okx_public_instrument(value: Any) -> str:
+    raw = str(value or "").strip().upper().replace("/", "-")
+    parts = raw.split("-")
+    if len(parts) != 2:
+        raise ValueError("unsupported OKX instrument")
+    asset = _normalize_okx_public_asset(parts[0])
+    quote = parts[1]
+    if quote not in OKX_PUBLIC_QUOTES:
+        raise ValueError("unsupported OKX quote")
+    return f"{asset}-{quote}"
@@
