llapsed404138="true";\n      document.documentElement.dataset.atlasHotCoreResident404138="true";\n    }catch(_){}\n  };\n\n  /* Close visually before residency registration. The HOT root is deliberately\n     NOT registered, therefore closing it can never detach its cockpit/runtime DOM. */\n  enforceCollapsedDefaults();\n\n  const registration=life.registerClosedBodyFamily({\n    id:"atlas",\n    label:"02 · Intelligence, mémoire & création",\n    selectors\n  });\n\n  /* The lifecycle may restore a stale hash during its initial load sweep.\n     Re-assert DEFAULT state after that one boot transaction. Explicit clicks\n     occurring after load are untouched. No recurring timer/observer is added. */\n  if(document.readyState==="complete") enforceCollapsedDefaults();\n  else window.addEventListener("load",enforceCollapsedDefaults,{once:true});\n\n  globalThis.ErithAtlasFamilyDemandResidency40415=Object.freeze({\n    build:"40.4.138",\n    parent_owner:"40.4.15",\n    strategy:"hot-core-resident + peripheral-closed-body-demand-residency",\n    hot_root:HOT_ROOT,\n    hot_root_registered_for_detach:false,\n    hot_root_default_open:false,\n    peripheral_default_open:false,\n    selectors,\n    registered:!!registration,\n    forge_iframe_excluded:true,\n    existing_internal_residency_preserved:true,\n    pending_wake_404137_preserved:true,\n    atlas_truth_state_engine_changed:false,\n    clone_used:false,\n    fetch_added:false,\n    timer_added:false,\n    observer_added:false,\n    storage_write_added:false,\n    snapshot:()=>life.residencySnapshot()\n  });\n})();\n')

# Finalize manifests from the canonical .136 parent without carrying stale .137 publication identity.
tracked=["index.html","app.js","js/app.js","js/aether.js","js/views/atlas-family-demand-residency.js"]
hashes={rel:sha(ROOT/rel) for rel in tracked}
now=datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00","Z")
line137="40.4.137 Atlas AUTO resident wake recovery: pending canonical survives readiness misses and retries only from existing readiness owners; all Atlas UI disclosures may remain closed"
line138="40.4.138 Atlas collapsed HOT-core residency boundary + AUTO wake recovery lock"

def common_manifest(d):
    d["build"]=BUILD
    d["release"]=RELEASE
    d["status"]=STATUS
    d["prepared_at"]=now
    d["published_at"]=now
    d["global_versioning"]=BUILD
    d["asset_token"]=TOKEN
    d["parent_build"]=PUBLIC_PARENT
    lineage=str(d.get("lineage") or "").rstrip(" .")
    for item in (line137,line138):
        if item not in lineage: lineage += " → "+item
    d["lineage"]=lineage+"."
    files=d.setdefault("files",{})
    files.update(hashes)
    integ=d.setdefault("integrity",{})
    integ["files"]=7
    integ["atlas_auto_resident_wake_404137"]={
      "build":"40.4.137","public_parent":"40.4.136","lost_wakeup_repaired":True,
      "pending_canonical_persists":True,"ui_disclosure_dependency":False,
      "new_recurring_timer":False,"new_observer":False,"new_network_owner":False
    }
    integ["atlas_collapsed_hot_core_404138"]={
      "build":BUILD,"public_parent":PUBLIC_PARENT,"includes":"40.4.137",
      "atlas_default_open":False,"atlas_hot_core_detachable_when_closed":False,
      "peripheral_disclosures_default_open":False,"firefox_operator_validation_required":True
    }
    notes=d.setdefault("release_notes",[])
    note137="40.4.137 — Atlas AUTO resident wake recovery: pending canonical survives readiness misses; existing Market/Graph/Binance/Bridge/post-auth owners retry the same transaction without new polling."
    note138="40.4.138 — Atlas is collapsed by default while its HOT cockpit remains resident; Auto Reader, Shared Memory and GitHub Memory stay collapsed/demand-resident; stale boot hash cannot reopen the disclosure."
    if note137 not in notes: notes.append(note137)
    if note138 not in notes: notes.append(note138)
    return d

ad=common_manifest(json.loads(read("administrator-version.json")))
ad["integrity"]["self_hash_policy"]="manifest self hash omitted; version.json records administrator-version.json candidate hash"
ad["integrity"]["publication_identity"]={"build":BUILD,"asset_token":TOKEN,"status":STATUS,"app_sha256":hashes["app.js"]}
write("administrator-version.json",json.dumps(ad,ensure_ascii=False,indent=2)+"\n")
admin_hash=sha(ROOT/"administrator-version.json")

ver=common_manifest(json.loads(read("version.json")))
ver["integrity"]["self_hash_policy"]="version.json self hash omitted; administrator-version.json candidate hash recorded after finalization"
ver["integrity"]["publication_identity"]={"build":BUILD,"asset_token":TOKEN,"status":STATUS,"app_sha256":hashes["app.js"],"administrator_version_sha256":admin_hash}
write("version.json",json.dumps(ver,ensure_ascii=False,indent=2)+"\n")

print("APPLIED",BUILD,"app",hashes["app.js"],"administrator-version",admin_hash,"version",sha(ROOT/"version.json"))
