  ],
  "instrument_types": [
    "spot",
    "spot_aggregate",
    "future",
    "official_benchmark",
    "official_market",
    "structural",
    "macro",
    "regulatory"
  ],
  "quote_record": {
    "required": [
      "domain",
      "asset_id",
      "symbol",
      "source_id",
      "instrument_type",
      "currency",
      "unit",
      "source_time",
      "received_at",
      "data_state"
    ],
    "numeric_nullable": [
      "price",
      "bid",
      "ask",
      "change",
      "change_percent"
    ],
    "fields": {
      "domain": "string",
      "asset_id": "string",
      "symbol": "string",
      "instrument": "string|null",
      "instrument_type": "enum",
      "source_id": "string",
      "market": "string|null",
      "price": "number|null",
      "currency": "string|null",
      "unit": "string|null",
      "bid": "number|null",
      "ask": "number|null",
      "change": "number|null",
      "change_percent": "number|null",
      "source_time": "ISO-8601|null",
      "received_at": "ISO-8601",
      "declared_delay_seconds": "number|null",
      "data_state": "enum",
      "licence_state": "string"
    }
  },
  "series_record": {
    "required": [
      "domain",
      "asset_id",
      "source_id",
      "period",
      "interval",
      "currency",
      "unit",
      "points",
      "received_at",
      "data_state"
    ],
    "point_fields": [
      "time",
      "open",
      "high",
      "low",
      "close",
      "volume"
    ],
    "empty_points_allowed": true,
    "fabricated_points_forbidden": true
  },
  "structural_fact": {
    "required": [
      "domain",
      "asset_id",
      "metric",
      "year",
